{
  "description": "Low-cost runs: every mind on haiku, the committee chair (Livia) included; committee voters and group proposers on haiku, no interns, shorter replies; game clock x3 for live runs, more turns and a web-call cap per decision.",
  "rosterTiers": {
    "*": "haiku"
  },
  "game": {
    "decisions": {
      "tiers": {
        "haiku": {
          "maxSteps": 35,
          "horizonFactor": 1,
          "cooldownFactor": 2,
          "maxTurns": 8,
          "maxOutputTokens": 2500,
          "maxConsults": 1,
          "maxWebCalls": 2
        },
        "sonnet": {
          "maxSteps": 50,
          "horizonFactor": 1.5,
          "cooldownFactor": 3,
          "maxTurns": 8,
          "maxOutputTokens": 4000,
          "maxConsults": 2,
          "maxWebCalls": 3
        }
      },
      "modelParams": {
        "reply": {
          "retryMaxTokens": 800
        },
        "prose": {
          "retryMaxTokens": 1200
        }
      }
    },
    "conversation": {
      "replyMaxOutputTokens": 500
    },
    "groups": {
      "memberTier": "haiku",
      "maxProposers": 2,
      "proseMaxOutputTokens": 1000
    },
    "crowd": {
      "count": 0
    },
    "births": {
      "childTier": "haiku"
    },
    "promptCache": {
      "enabled": true,
      "ttl": "5m",
      "groupTtl": "5m"
    },
    "loop": {
      "timeScale": 3
    }
  }
}
